---
interface Props {
  name: 'arrow' | 'book' | 'sun' | 'case' | 'award' | 'check' | 'pin' | 'phone' | 'globe';
  size?: number;
}
const { name, size = 24 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'book' && <><path d="M12 5v15M3 4c4-1 6 0 9 2 3-2 5-3 9-2v15c-4-1-6 0-9 2-3-2-5-3-9-2Z" /></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></>}
  {name === 'case' && <><rect x="3" y="7" width="18" height="14" rx="2" /><path d="M8 7V4h8v3M3 12c5 4 13 4 18 0m-9 1v4" /></>}
  {name === 'award' && <><circle cx="12" cy="8" r="6" /><path d="m8 13-2 9 6-3 6 3-2-9m-6-5 1.5 1.5L15 6" /></>}
  {name === 'check' && <path d="m5 12 4 4L19 6" />}
  {name === 'pin' && <><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'phone' && <path d="m7 3 3 5-3 3c1 3 3 5 6 6l3-3 5 3c-1 5-4 5-6 4C8 19 5 16 3 9 2 5 4 3 7 3Z" />}
  {name === 'globe' && <><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18" /></>}
</svg>
